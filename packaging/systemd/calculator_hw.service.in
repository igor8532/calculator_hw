[Unit]
Description=Calculator HW service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
ExecStart=@CALCULATOR_HW_EXECUTABLE@
EnvironmentFile=-/etc/calculator_hw/calculator_hw.env
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

User=calculator
Group=calculator

StateDirectory=calculator_hw
WorkingDirectory=/var/lib/calculator_hw

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
